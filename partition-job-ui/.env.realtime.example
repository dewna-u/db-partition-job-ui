# NEW realtime database only — production-copy / sensitive application data.
# Do NOT point this at live production or the old reference DB without review.
# Copy to .env.realtime and fill in real values. .env.realtime is git-ignored.

# Fail-closed identity check (required). Must equal current_database().
REALTIME_DB_EXPECTED_NAME=your_new_realtime_database

# Migration tooling gate (default absent/false). Does NOT affect scheduler runtime.
# Set to true ONLY after explicit approval to run migration tooling checks.
# PARTITION_REALTIME_ALLOW_MIGRATION=false

# Target database for the realtime scheduler backend
DB_HOST=127.0.0.1
DB_PORT=5444
DB_NAME=your_new_realtime_database
DB_USER=partition_job_scheduler
DB_PASSWORD=replace_with_strong_password
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5

# Optional: Streamlit UI role against the same NEW database (separate from scheduler)
# UI_DB_USER=partition_job_ui
# UI_DB_PASSWORD=replace_with_strong_password

# Scheduler backend timing (seconds)
PARTITION_SCHEDULER_LOOKAHEAD_SECONDS=120
PARTITION_SCHEDULER_RECONCILE_SECONDS=30
PARTITION_SCHEDULER_CONNECT_RETRY_SECONDS=5
PARTITION_SCHEDULER_MAX_CONNECT_RETRY_SECONDS=60

# Localhost-only control API (do not bind to public interfaces)
PARTITION_SCHEDULER_BIND_HOST=127.0.0.1
PARTITION_SCHEDULER_BIND_PORT=8765

# URL used by Streamlit after successful config writes (signal only)
PARTITION_SCHEDULER_REFRESH_URL=http://127.0.0.1:8765/internal/scheduler/refresh
PARTITION_SCHEDULER_STATUS_URL=http://127.0.0.1:8765/internal/scheduler/status
PARTITION_SCHEDULER_REFRESH_TIMEOUT_SECONDS=2

# OS singleton lock file (Linux production example; Windows uses temp dir by default in code)
PARTITION_SCHEDULER_LOCK_FILE=/tmp/partition-job-scheduler.lock

# SQL object names (plain identifiers only)
PARTITION_JOB_SCHEMA=mubasher_oms
PARTITION_UPCOMING_JOBS_FUNCTION=get_upcoming_partition_jobs
PARTITION_SCHEDULED_RUN_FUNCTION=run_partition_job_scheduled
