# NEW realtime database only — production-copy / sensitive application data.
# Do NOT point this at live production or the old reference DB without review.
# Copy to .env.realtime and fill in real values. .env.realtime is git-ignored.

# Fail-closed identity check (required). Must equal current_database().
REALTIME_DB_EXPECTED_NAME=your_new_realtime_database

# Migration tooling gate (default absent/false). Does NOT affect scheduler runtime.
# Set to true ONLY after explicit approval to run migration tooling checks.
# PARTITION_REALTIME_ALLOW_MIGRATION=false

# Target database for the realtime scheduler backend
DB_HOST=127.0.0.1
DB_PORT=5444
DB_NAME=your_new_realtime_database
DB_USER=partition_job_scheduler
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5

# Credential provider: env (default / rollback) or aws (production)
PARTITION_DB_SECRET_PROVIDER=env

# --- env provider ---
DB_PASSWORD=replace_with_strong_password

# --- aws provider (EC2 IAM instance role — no access keys in this file) ---
# PARTITION_DB_SECRET_PROVIDER=aws
# PARTITION_DB_SECRET_ID=partops/example/db-credentials
# AWS_REGION=<aws-region>
# PARTITION_DB_SECRET_CACHE_TTL_SECONDS=300
# After AWS mode is verified, remove DB_PASSWORD from this file.

# Optional: Streamlit UI role against the same NEW database (separate from scheduler)
# UI_DB_USER=partition_job_ui
# UI_DB_PASSWORD=replace_with_strong_password

# Scheduler backend timing (seconds)
PARTITION_SCHEDULER_LOOKAHEAD_SECONDS=120
PARTITION_SCHEDULER_RECONCILE_SECONDS=30
PARTITION_SCHEDULER_CONNECT_RETRY_SECONDS=5
PARTITION_SCHEDULER_MAX_CONNECT_RETRY_SECONDS=60

# Max simultaneous scheduled DB executions (default 1 = serial).
# Roll out: 1 first, then 2 after verification, then 3 only if DB capacity allows.
# Rejects 0 / negative / float / non-integer. Do not set production default to 3.
PARTITION_SCHEDULER_MAX_CONCURRENT_JOBS=1

# ---------------------------------------------------------------------------
# Phase 5A — missed runs and bounded retry. All optional; defaults shown.
# Invalid values stop the scheduler at startup (fail safe; never coerced).
# ---------------------------------------------------------------------------
# Missed-run classification is by OWNERSHIP, not by a fixed lateness window:
#  * OWNED      — first seen before it was due (lookahead) or no more than
#                 OVERDUE_TOLERANCE seconds after it. May run late after waiting
#                 for a concurrency slot / busy table / retry backoff.
#  * HISTORICAL — first seen later than that (scheduler start after downtime,
#                 DB outage). NEVER executed; recorded for DBA review and the
#                 job moves to its next future occurrence.
# The tolerance only absorbs timer/refresh jitter (0..600 s). Ownership is
# in-memory: after a scheduler restart, already-overdue occurrences are
# HISTORICAL by design. LOOKAHEAD must be >= RECONCILE (checked at startup).
# PARTITION_SCHEDULER_OVERDUE_TOLERANCE_SECONDS=60
#
# FAILED_DATABASE / FAILED_CONNECTION on an owned occurrence:
# total execution attempts (1..10) and the delays between them (1..3600 s
# each, last value repeats). Defaults retry for ~4 min (DB restart/failover),
# then the occurrence becomes a RETRY_EXHAUSTED review item and is NEVER
# executed again automatically.
# PARTITION_SCHEDULER_RETRY_MAX_ATTEMPTS=4
# PARTITION_SCHEDULER_RETRY_DELAYS_SECONDS=15,60,180
#
# SKIPPED_TARGET_LOCKED / SKIPPED_LOCKED (table busy — not a failure):
# cooldowns between attempts (last value repeats) and the total wait budget
# (30..21600 s) before it becomes a RETRY_EXHAUSTED review item.
# PARTITION_SCHEDULER_TARGET_LOCK_COOLDOWN_SECONDS=5,10,20,30
# PARTITION_SCHEDULER_TARGET_LOCK_MAX_WAIT_SECONDS=3600
#
# First back-off when a DB reconcile call itself fails (doubles, cap 600 s).
# PARTITION_SCHEDULER_EXHAUSTED_RETRY_SECONDS=60
#
# Phase 5B framework gate (always ON): before dispatching anything the
# scheduler verifies, READ-ONLY, that the database has every required
# execution function (expected signatures, EXECUTE for this role), the
# attention/log tables and framework version 20261110_03
# (sql/framework/framework_manifest.json). While it fails, NOTHING is
# executed or reconciled; it re-checks every N seconds (30..3600).
# PARTITION_SCHEDULER_FRAMEWORK_RECHECK_SECONDS=300
#
# DB safety ceiling (not configured here): the database never executes a
# scheduled occurrence later than mubasher_oms.partition_job_max_execution_lateness()
# (default 6 hours) after its scheduled time, whatever the scheduler claims.

# Localhost-only control API (do not bind to public interfaces)
PARTITION_SCHEDULER_BIND_HOST=127.0.0.1
PARTITION_SCHEDULER_BIND_PORT=8765

# URL used by UI/API after successful config writes (signal only)
PARTITION_SCHEDULER_REFRESH_URL=http://127.0.0.1:8765/internal/scheduler/refresh
PARTITION_SCHEDULER_STATUS_URL=http://127.0.0.1:8765/internal/scheduler/status
PARTITION_SCHEDULER_REFRESH_TIMEOUT_SECONDS=2

# OS singleton lock file (Linux production example; Windows uses temp dir by default in code)
PARTITION_SCHEDULER_LOCK_FILE=/tmp/partition-job-scheduler.lock

# SQL object names (plain identifiers only)
PARTITION_JOB_SCHEMA=mubasher_oms
PARTITION_UPCOMING_JOBS_FUNCTION=get_upcoming_partition_jobs
PARTITION_SCHEDULED_RUN_FUNCTION=run_partition_job_scheduled

# ---------------------------------------------------------------------------
# Datadog observability (optional; Agent owns the API key — never put it in PartOps env)
# ---------------------------------------------------------------------------
PARTOPS_DATADOG_ENABLED=false
PARTOPS_DOGSTATSD_HOST=127.0.0.1
PARTOPS_DOGSTATSD_PORT=8125
PARTOPS_ENVIRONMENT=unknown
# PARTOPS_METRICS_NAMESPACE=partops
# After Datadog Agent is installed and DogStatsD listens on localhost:8125:
# PARTOPS_DATADOG_ENABLED=true
# PARTOPS_ENVIRONMENT=production

# NOTE: The scheduler process loads ONLY this file (.env.realtime).
# Do not depend on UI .env (owned by partitionui). Keep mode 600 / enterprisedb.

# ---------------------------------------------------------------------------
# Phase 5C — database targets (registry lives in the control database)
# ---------------------------------------------------------------------------
# The control database (target db01) uses the settings above (inherit).
# Additional targets are registered by a DBA in mubasher_oms.partops_database_target.
# aws targets use their own secret_id from the registry (fail closed).
# env targets are for LOCAL DEVELOPMENT ONLY — never put real passwords here:
# PARTOPS_TARGET_DB02_DB_USER=partition_job_scheduler
# PARTOPS_TARGET_DB02_DB_PASSWORD=local-dev-only

# ---------------------------------------------------------------------------
# Phase 5D — remote execution (scheduler)
# ---------------------------------------------------------------------------
# Target availability cooldown after connection-level failures (capped exp.).
# PARTITION_SCHEDULER_TARGET_COOLDOWN_BASE_SECONDS=15
# PARTITION_SCHEDULER_TARGET_COOLDOWN_MAX_SECONDS=300
# Cached per-target target_execution preflight.
# PARTITION_SCHEDULER_TARGET_PREFLIGHT_TTL_SECONDS=300
# Manual remote runs wait at most this long for a target/global slot.
# PARTITION_SCHEDULER_MANUAL_SLOT_TIMEOUT_SECONDS=60
