# Main database containing the partition function (UI / API process)
DB_HOST=<host>
DB_PORT=<port>
DB_NAME=<database>
DB_USER=partition_job_ui
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5

# Credential provider: env (default / local / rollback) or aws (production)
# Default is env so existing deployments keep working after git pull.
PARTITION_DB_SECRET_PROVIDER=env

# --- env provider (local / rollback) ---
DB_PASSWORD=replace_with_strong_password

# --- aws provider (production; EC2 IAM instance role — no access keys) ---
# PARTITION_DB_SECRET_PROVIDER=aws
# PARTITION_DB_SECRET_ID=partops/example/db-credentials
# AWS_REGION=<aws-region>
# PARTITION_DB_SECRET_CACHE_TTL_SECONDS=300
# After AWS mode is verified, remove DB_PASSWORD from this file.

# Optional pgAgent database configuration.
# Leave these blank to use the main database configuration.
PGAGENT_DB_HOST=
PGAGENT_DB_PORT=
PGAGENT_DB_NAME=
PGAGENT_DB_USER=
PGAGENT_DB_PASSWORD=
PGAGENT_DB_SSLMODE=

# Scheduler control API signals (UI/API process -> scheduler on localhost)
PARTITION_SCHEDULER_REFRESH_URL=http://127.0.0.1:8765/internal/scheduler/refresh
PARTITION_SCHEDULER_STATUS_URL=http://127.0.0.1:8765/internal/scheduler/status
PARTITION_SCHEDULER_REFRESH_TIMEOUT_SECONDS=2

# Next.js rewrite target when not set in systemd (PartOps API on 8001)
# PARTITION_API_ORIGIN=http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# Datadog observability (optional; Agent owns the API key — never put it in PartOps env)
# ---------------------------------------------------------------------------
PARTOPS_DATADOG_ENABLED=false
PARTOPS_DOGSTATSD_HOST=127.0.0.1
PARTOPS_DOGSTATSD_PORT=8125
# Neutral default; set explicitly on the server (e.g. production) when enabling metrics.
PARTOPS_ENVIRONMENT=unknown
# PARTOPS_METRICS_NAMESPACE=partops
# After Datadog Agent is installed and DogStatsD listens on localhost:8125:
# PARTOPS_DATADOG_ENABLED=true
# PARTOPS_ENVIRONMENT=production
